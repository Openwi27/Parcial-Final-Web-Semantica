<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://www.Salud-AbleNutricion.com/ontologia"
         xmlns="http://www.Salud-AbleNutricion.com/ontologia#">

<owl:Ontology rdf:about="http://www.Salud-AbleNutricion.com/ontologia"/>

<owl:ObjectProperty rdf:about="#padece">
  <rdfs:domain rdf:resource="#Usuario"/>
  <rdfs:range rdf:resource="#CondicionClinica"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#contraindica">
  <rdfs:domain rdf:resource="#CondicionClinica"/>
  <rdfs:range>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Alimento"/>
        <rdf:Description rdf:about="#Alergeno"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:range>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#recibe">
  <rdfs:domain rdf:resource="#Usuario"/>
  <rdfs:range rdf:resource="#Dieta"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#incluye">
  <rdfs:domain rdf:resource="#Dieta"/>
  <rdfs:range rdf:resource="#Receta"/>
  <owl:inverseOf rdf:resource="#esIncluidaEn"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#compuestaPor">
  <rdfs:domain rdf:resource="#Receta"/>
  <rdfs:range rdf:resource="#Alimento"/>
  <rdfs:subPropertyOf rdf:resource="#tieneComponente"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#contiene">
  <rdfs:domain rdf:resource="#Alimento"/>
  <rdfs:range>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Nutriente"/>
        <rdf:Description rdf:about="#Alergeno"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:range>
  <rdfs:subPropertyOf rdf:resource="#tieneComponente"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#esIncluidaEn">
  <rdfs:domain rdf:resource="#Receta"/>
  <rdfs:range rdf:resource="#Dieta"/>
  <owl:inverseOf rdf:resource="#incluye"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#tieneComponente">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:domain rdf:resource="#EntidadGastronomica"/>
  <rdfs:range>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#EntidadGastronomica"/>
        <rdf:Description rdf:about="#ComponenteQuimico"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:range>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#tieneDisponibilidadInventario">
  <rdfs:domain rdf:resource="#Alimento"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#caloriasTotales">
  <rdfs:domain rdf:resource="#Dieta"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#nivelSeveridad">
  <rdfs:domain rdf:resource="#RestriccionAlimentaria"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Persona">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Usuario">
  <rdfs:subClassOf rdf:resource="#Persona"/>
</owl:Class>

<owl:Class rdf:about="#CondicionClinica">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:disjointWith rdf:resource="#EntidadGastronomica"/>
</owl:Class>

<owl:Class rdf:about="#Patologia">
  <rdfs:subClassOf rdf:resource="#CondicionClinica"/>
</owl:Class>

<owl:Class rdf:about="#RestriccionAlimentaria">
  <rdfs:subClassOf rdf:resource="#CondicionClinica"/>
</owl:Class>

<owl:Class rdf:about="#EntidadGastronomica">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Dieta">
  <rdfs:subClassOf rdf:resource="#EntidadGastronomica"/>
</owl:Class>

<owl:Class rdf:about="#Receta">
  <rdfs:subClassOf rdf:resource="#EntidadGastronomica"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#compuestaPor"/>
      <owl:someValuesFrom rdf:resource="#Alimento"/>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#Alimento">
  <rdfs:subClassOf rdf:resource="#EntidadGastronomica"/>
</owl:Class>

<owl:Class rdf:about="#ComponenteQuimico">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Nutriente">
  <rdfs:subClassOf rdf:resource="#ComponenteQuimico"/>
</owl:Class>

<owl:Class rdf:about="#Alergeno">
  <rdfs:subClassOf rdf:resource="#ComponenteQuimico"/>
</owl:Class>

<owl:Class rdf:about="#DietaSegura">
  <rdfs:subClassOf rdf:resource="#Dieta"/>
</owl:Class>


</rdf:RDF>
